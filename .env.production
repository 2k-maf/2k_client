# Продакшн-збірка не публікує мапи джерел. Воркфлов деплою заливає
# build/static на CDN з річним кешем, тому *.js.map там читає будь-хто.
GENERATE_SOURCEMAP=false

# Базовий URL API в проді — порожній рядок, тобто той самий origin.
# CloudFront направляє кореневі шляхи Express у Lambda, тому абсолютний хост
# не потрібен.
#
# Рядок обов'язковий, і ось чому. CRA бере значення з .env.production, а те,
# чого тут немає, добирає з .env. Файл .env лежить у .gitignore і на машині
# розробника містить http://localhost:3000. Без цього рядка локальна збірка
# зашивала б localhost у продакшн-бандл. Так уже сталося 2026-09-07.
REACT_APP_API_URL=

# Id клубу, який показує публічна сторінка рейтингу.
#
# Це клуб "Dva kol'ory" у базі 2colors. Міграція 2026-09-07 перенесла в нього
# всі 80 користувачів, 180 ігор і 3 рейтингові періоди.
#
# Значення дублює фолбек у src/constants/club.ts. Рядок лишається явним, бо
# CRA добирає незадані змінні з .env, а .env лежить у .gitignore і на машині
# розробника містить свої значення.
REACT_APP_CLUB_ID=67c0dc3b110964e2fdac7b37
